rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function enrollmentDoc(uid, cid) { return /databases/$(database)/documents/enrollments/$(uid + '_' + cid); }
    function classDoc(cid) { return /databases/$(database)/documents/classes/$(cid); }
    function weekDoc(cid,wid) { return /databases/$(database)/documents/classes/$(cid)/weeks/$(wid); }
    function admin() {
      return signedIn() && exists(userDoc(request.auth.uid)) &&
        get(userDoc(request.auth.uid)).data.role == 'admin';
    }
    // 수강 중(active) 등록이 있는 학생. 반이 보관된 뒤에도 지난 자료를 읽을 수 있게 읽기 권한에 씁니다.
    function enrolled(cid) {
      return signedIn() && exists(enrollmentDoc(request.auth.uid,cid)) &&
        get(enrollmentDoc(request.auth.uid,cid)).data.status == 'active';
    }
    // 운영 중인(보관되지 않은) 반의 수강생. 제출·질문 등 쓰기 권한에 씁니다.
    function member(cid) {
      return enrolled(cid) && get(classDoc(cid)).data.archived == false;
    }
    function visible(cid,wid) { return get(weekDoc(cid,wid)).data.published == true; }
    // D4(2026-10-29 확정): 한 학생은 동시에 한 반만 수강합니다.
    // 배정된 반이 없거나, 배정된 반의 수강이 끝났으면(수강 중지·반 이동 또는 반 보관) 다음 반에 입장할 수 있습니다.
    function assignedClass(uid) { return get(userDoc(uid)).data.get('assignedClassId', ''); }
    function finishedAssigned(uid) {
      return assignedClass(uid) == '' ||
        !exists(enrollmentDoc(uid, assignedClass(uid))) ||
        get(enrollmentDoc(uid, assignedClass(uid))).data.status != 'active' ||
        !exists(classDoc(assignedClass(uid))) ||
        get(classDoc(assignedClass(uid))).data.archived == true;
    }
    function canJoin(uid, cid) { return assignedClass(uid) == cid || finishedAssigned(uid); }

    // 수강 코드를 아는 로그인 사용자만 문서 하나를 조회할 수 있습니다.
    // 반 전체 목록 조회와 임의 수정은 불가합니다.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if admin() &&
        request.resource.data.keys().hasOnly(['classId','createdBy','updatedAt']) &&
        request.resource.data.classId is string &&
        request.resource.data.createdBy == request.auth.uid;
      allow delete: if admin();
    }
    match /users/{uid} {
      allow get: if admin() || (signedIn() && request.auth.uid == uid);
      allow list: if admin();
      allow create: if admin() ||
        (signedIn() && request.auth.uid == uid &&
         request.resource.data.keys().hasOnly(['displayName','realName','nickname','email','role','createdAt']) &&
         request.resource.data.role == 'student' &&
         request.resource.data.email == request.auth.token.email &&
         request.resource.data.displayName is string &&
         request.resource.data.realName is string && request.resource.data.realName.size()>0 && request.resource.data.realName.size()<=35 &&
         request.resource.data.nickname == '' && request.resource.data.displayName == request.resource.data.realName);
      allow update: if admin() ||
        (signedIn() && request.auth.uid == uid &&
         (
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','realName','nickname','updatedAt']) && request.resource.data.displayName is string && request.resource.data.get('nickname','') is string && request.resource.data.get('realName','') is string && request.resource.data.get('nickname','').size() <= 35 && request.resource.data.get('realName','').size() <= 35)
           ||
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedClassId']) &&
             (!('assignedClassId' in resource.data) || finishedAssigned(uid)) &&
             request.resource.data.assignedClassId is string &&
             exists(enrollmentDoc(uid,request.resource.data.assignedClassId)) &&
             get(enrollmentDoc(uid,request.resource.data.assignedClassId)).data.status == 'active')
         ));
      allow delete: if admin();
    }
    match /enrollments/{eid} {
      allow get, list: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      // 강사는 반 이동·재등록 때 학생의 새 반 등록을 만들 수 있어야 합니다(P0-08).
      allow create: if admin() || signedIn() &&
        request.resource.data.keys().hasOnly(['uid','classId','studentName','email','joinCode','status','joinedAt']) &&
        request.resource.data.uid == request.auth.uid &&
        eid == request.auth.uid + '_' + request.resource.data.classId &&
        request.resource.data.status == 'active' &&
        request.resource.data.studentName is string &&
        request.resource.data.email == request.auth.token.email &&
        exists(classDoc(request.resource.data.classId)) &&
        get(classDoc(request.resource.data.classId)).data.archived == false &&
        get(classDoc(request.resource.data.classId)).data.joinCode == request.resource.data.joinCode &&
        get(userDoc(request.auth.uid)).data.role == 'student' &&
        canJoin(request.auth.uid, request.resource.data.classId);
      allow update, delete: if admin();

      // P1-04: 수강 기간 기록(변경 불가). 학생은 수강 등록을 만들 때 같은 일괄 쓰기로 'joined' 기록 하나만 남길 수 있습니다.
      match /events/{evid} {
        function enrollmentAfter() { return getAfter(/databases/$(database)/documents/enrollments/$(eid)).data; }
        allow get, list: if admin();
        allow create: if admin() ||
          (signedIn() &&
           !exists(/databases/$(database)/documents/enrollments/$(eid)) &&
           enrollmentAfter().uid == request.auth.uid &&
           request.resource.data.keys().hasOnly(['type','at','by','toClassId']) &&
           request.resource.data.type == 'joined' &&
           request.resource.data.by == request.auth.uid &&
           request.resource.data.at == request.time &&
           request.resource.data.get('toClassId', '') == enrollmentAfter().classId);
        allow update: if false;
        allow delete: if admin();
      }
    }
    match /classes/{cid} {
      // 보관된 반도 수강했던 학생은 읽을 수 있습니다(지난 자료 열람, 2026-10-29 요청). 강의 영상 파일은 Storage 규칙에서 막습니다.
      allow get: if admin() || enrolled(cid);
      allow list: if admin();
      allow create, update, delete: if admin();

      // 수강생 개인 특이사항: 강사에게만 공개. 학생은 읽거나 쓸 수 없습니다.
      match /teacherNotes/{uid} {
        allow get, list, create, update, delete: if admin();
      }
      // 배치 11: 다음 학습 목표 — 강사가 쓰고, 그 학생 본인만 읽습니다(강사 메모와 저장 위치를 나눔).
      match /studentGoals/{uid} {
        allow get: if admin() || (signedIn() && request.auth.uid == uid && enrolled(cid));
        allow list, delete: if admin();
        allow create, update: if admin() &&
          request.resource.data.keys().hasOnly(['text','updatedAt','updatedBy']) &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200;
      }
      // 공지사항(2026-10-29 추가): 강사가 쓰고, 이 반 수강생이 읽습니다. 보관된 반도 읽을 수 있습니다.
      match /notices/{nid} {
        allow get, list: if admin() || enrolled(cid);
        allow create, update: if admin() &&
          request.resource.data.keys().hasOnly(['title','body','pinned','createdAt','updatedAt','createdBy','authorName']) &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100 &&
          request.resource.data.body is string && request.resource.data.body.size() <= 5000 &&
          request.resource.data.get('pinned', false) is bool;
        allow delete: if admin();
      }
      // 공지 확인 시각: 학생이 공지 화면을 연 서버 시각 하나. '새 공지' 표시와 강사 화면의 '읽음' 수에 씁니다.
      match /noticeReads/{uid} {
        allow get: if admin() || (signedIn() && request.auth.uid == uid && enrolled(cid));
        allow list, delete: if admin();
        allow create, update: if signedIn() && request.auth.uid == uid && member(cid) &&
          request.resource.data.keys().hasOnly(['seenAt']) && request.resource.data.seenAt == request.time;
      }

      // 공개 반명단: 이메일/성적/과제는 넣지 않으며 같은 반 학생만 읽습니다.
      match /members/{uid} {
        allow get, list: if admin() || enrolled(cid);
        allow create: if admin() || (member(cid) && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['uid','name','status','joinedAt']) &&
          request.resource.data.uid == uid && request.resource.data.name is string &&
          request.resource.data.name.size() <= 35 && request.resource.data.status == 'active');
        allow update: if admin() || (member(cid) && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
          request.resource.data.name is string && request.resource.data.name.size() <= 35);
        allow delete: if admin();
      }

      // 질문과 댓글: 본인 작성 질문 또는 강사 계정에서만 열람.
      match /questions/{qid} {
        function owner() {return signedIn() && resource.data.uid == request.auth.uid && enrolled(cid);}
        function ownsQuestion() {return signedIn() && enrolled(cid) &&
          get(/databases/$(database)/documents/classes/$(cid)/questions/$(qid)).data.uid == request.auth.uid;}
        allow get, list: if admin() || owner();
        allow create: if member(cid) &&
          request.resource.data.keys().hasOnly(['uid','studentName','title','content','createdAt','status','needsTeacherReply','lastMessageAt','lastSenderRole','weekId','context']) &&
          request.resource.data.uid == request.auth.uid && request.resource.data.status == 'open' &&
          request.resource.data.get('needsTeacherReply', true) == true &&
          request.resource.data.get('lastSenderRole', 'student') == 'student' &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100 &&
          request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 8000 &&
          // 배치 10: 질문에 차시를 연결할 수 있습니다(선택). '이 피드백에 질문하기'는 context로 과제·복습을 구분합니다.
          request.resource.data.get('weekId', '') is string && request.resource.data.get('weekId', '').size() <= 100 &&
          request.resource.data.get('context', 'general') in ['general', 'assignment', 'quiz'];
        // P0-03: 학생은 자기 질문에 추가 질문을 남길 때 '답변 대기'로 되돌리는 필드만 바꿀 수 있습니다.
        allow update: if admin() ||
          (signedIn() && resource.data.uid == request.auth.uid && member(cid) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','needsTeacherReply','lastMessageAt','lastSenderRole','updatedAt']) &&
           request.resource.data.status == 'open' &&
           request.resource.data.needsTeacherReply == true &&
           request.resource.data.lastSenderRole == 'student' &&
           request.resource.data.lastMessageAt == request.time) ||
          // P1-05: 학생이 대화를 연 시각
          (signedIn() && resource.data.uid == request.auth.uid && member(cid) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentSeenAt']) &&
           request.resource.data.studentSeenAt == request.time);
        allow delete: if admin();

        match /replies/{rid} {
          allow get, list: if admin() || ownsQuestion();
          allow create: if (admin() || (ownsQuestion() && member(cid))) &&
            request.resource.data.keys().hasOnly(['uid','role','author','text','createdAt']) &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.role == (admin() ? 'admin' : 'student') &&
            request.resource.data.author is string &&
            request.resource.data.text is string && request.resource.data.text.size() > 0 &&
            request.resource.data.text.size() <= 8000;
          allow update, delete: if admin();
        }
      }

      match /weeks/{wid} {
        // 수강생 목록 조회는 반드시 where('published','==',true) 조건을 사용해야 합니다.
        allow get, list: if admin() || (enrolled(cid) && resource.data.published == true);
        allow create, update, delete: if admin();

        match /submissions/{uid} {
          function changed(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
          allow get, list: if admin() ||
            (signedIn() && request.auth.uid == uid && enrolled(cid) && visible(cid,wid));
          allow create: if signedIn() && request.auth.uid == uid && member(cid) &&
            visible(cid,wid) && get(weekDoc(cid,wid)).data.assignment.enabled == true &&
            request.resource.data.keys().hasOnly(['userId','studentName','email','text','audioPath','audioDuration','submittedAt','revision','firstSubmittedAt','latestSubmittedAt']) &&
            (request.resource.data.get('audioDuration', null) == null || request.resource.data.audioDuration is number) &&
            request.resource.data.get('revision', 1) == 1 &&
            request.resource.data.get('firstSubmittedAt', request.time) == request.time &&
            request.resource.data.userId == uid && request.resource.data.text is string &&
            request.resource.data.text.size() <= 20000 && request.resource.data.audioPath is string &&
            (request.resource.data.audioPath == '' || request.resource.data.audioPath.matches('^classes/' + cid + '/submissions/' + wid + '/' + uid + '/.*$'));
          allow update: if admin() ||
            // P1-05: 학생이 피드백을 본 시각
            (signedIn() && request.auth.uid == uid && member(cid) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentSeenFeedbackAt']) &&
             request.resource.data.studentSeenFeedbackAt == request.time) ||
            (signedIn() && request.auth.uid == uid && member(cid) && visible(cid,wid) &&
             get(weekDoc(cid,wid)).data.assignment.enabled == true &&
             request.resource.data.userId == uid &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentName','email','text','audioPath','audioDuration','submittedAt','revision','firstSubmittedAt','latestSubmittedAt']) &&
             (request.resource.data.get('audioDuration', null) == null || request.resource.data.audioDuration is number) &&
             // P0-04: 제출 회차는 1씩만 오르고, 처음 제출 시각은 한 번 정해지면 바뀌지 않습니다(이전 문서는 기존 submittedAt으로 정함).
             (!changed(['revision']) || request.resource.data.revision == resource.data.get('revision', 1) + 1) &&
             (!changed(['firstSubmittedAt']) || (!('firstSubmittedAt' in resource.data) && request.resource.data.firstSubmittedAt == resource.data.submittedAt)) &&
             (!changed(['latestSubmittedAt']) || request.resource.data.latestSubmittedAt == request.time) &&
             request.resource.data.text is string && request.resource.data.text.size() <= 20000 &&
             request.resource.data.audioPath is string &&
             (request.resource.data.audioPath == '' || request.resource.data.audioPath.matches('^classes/' + cid + '/submissions/' + wid + '/' + uid + '/.*$')));
          allow delete: if admin();

          // P1-01: 제출 이력(제출 1회 = 문서 1개, 문서 ID = 회차). 만들기만 하고 수정·삭제하지 않습니다(강사의 영구 삭제만 예외).
          match /revisions/{rev} {
            function summary() { return /databases/$(database)/documents/classes/$(cid)/weeks/$(wid)/submissions/$(uid); }
            allow get, list: if admin() || (signedIn() && request.auth.uid == uid && enrolled(cid) && visible(cid,wid));
            allow create: if signedIn() && request.auth.uid == uid && member(cid) && visible(cid,wid) &&
              get(weekDoc(cid,wid)).data.assignment.enabled == true &&
              request.resource.data.keys().hasOnly(['revision','text','audioPath','audioDuration','submittedAt','studentName','legacy']) &&
              request.resource.data.revision is int && rev == string(request.resource.data.revision) &&
              request.resource.data.text is string && request.resource.data.text.size() <= 20000 &&
              request.resource.data.audioPath is string &&
              (request.resource.data.audioPath == '' || request.resource.data.audioPath.matches('^classes/' + cid + '/submissions/' + wid + '/' + uid + '/.*$')) &&
              (
                // 새 제출: 요약 문서의 새 회차와 같고, 제출 시각은 지금
                (request.resource.data.revision == getAfter(summary()).data.revision &&
                 request.resource.data.submittedAt == request.time &&
                 request.resource.data.get('legacy', false) == false)
                ||
                // 회차 정보가 없던 이전 제출을 처음 다시 낼 때: 그 내용을 1차 기록으로 그대로 보존
                (request.resource.data.revision == 1 && request.resource.data.legacy == true &&
                 exists(summary()) && !('revision' in get(summary()).data) &&
                 request.resource.data.text == get(summary()).data.get('text', '') &&
                 request.resource.data.audioPath == get(summary()).data.get('audioPath', '') &&
                 request.resource.data.submittedAt == get(summary()).data.submittedAt)
              );
            allow update: if false;
            allow delete: if admin();
          }
        }
        // P1-02: 퀴즈 버전 사본(정답 포함) — 강사 전용
        match /quizVersions/{version} {
          allow get, list, create, update, delete: if admin();
        }
        match /quizResults/{uid} {
          allow get, list: if admin() ||
            (signedIn() && request.auth.uid == uid && enrolled(cid) && visible(cid,wid));
          allow create: if signedIn() && request.auth.uid == uid && member(cid) &&
            visible(cid,wid) && get(weekDoc(cid,wid)).data.quiz.enabled == true &&
            request.resource.data.keys().hasOnly(['userId','studentName','email','answers','answersById','questionIds','quizVersion','score','total','submittedAt','firstAttempt','attemptCount']) &&
            request.resource.data.get('answersById', {}) is map &&
            request.resource.data.userId == uid && request.resource.data.answers is list &&
            request.resource.data.answers.size() <= 200 &&
            request.resource.data.score is int && request.resource.data.total is int &&
            request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total &&
            request.resource.data.firstAttempt.score == request.resource.data.score &&
            request.resource.data.firstAttempt.total == request.resource.data.total &&
            request.resource.data.attemptCount == 1;
          allow update: if admin() ||
            // P1-05: 학생이 피드백을 본 시각
            (signedIn() && request.auth.uid == uid && member(cid) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentSeenFeedbackAt']) &&
             request.resource.data.studentSeenFeedbackAt == request.time) ||
            (signedIn() && request.auth.uid == uid && member(cid) && visible(cid,wid) &&
             get(weekDoc(cid,wid)).data.quiz.enabled == true &&
             request.resource.data.userId == uid &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentName','email','answers','answersById','questionIds','quizVersion','score','total','submittedAt','firstAttempt','attemptCount']) &&
             request.resource.data.get('answersById', {}) is map &&
             request.resource.data.answers is list && request.resource.data.answers.size() <= 200 &&
             request.resource.data.score is int && request.resource.data.total is int &&
             request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total &&
             request.resource.data.attemptCount is int && request.resource.data.attemptCount >= 1 &&
             (
               (('firstAttempt' in resource.data) && request.resource.data.firstAttempt == resource.data.firstAttempt)
               ||
               (!('firstAttempt' in resource.data) &&
                 request.resource.data.firstAttempt.score == resource.data.score &&
                 request.resource.data.firstAttempt.total == resource.data.total)
             ));
          allow delete: if admin();

          match /attempts/{attemptId} {
            allow get, list: if admin() || (signedIn() && request.auth.uid == uid && enrolled(cid) && visible(cid,wid));
            allow create: if signedIn() && request.auth.uid == uid && member(cid) && visible(cid,wid) &&
              get(weekDoc(cid,wid)).data.quiz.enabled == true &&
              request.resource.data.keys().hasOnly(['userId','answers','answersById','questionIds','quizVersion','score','total','attemptNumber','submittedAt','mode']) &&
              request.resource.data.get('answersById', {}) is map &&
              request.resource.data.userId == uid && request.resource.data.answers is list && request.resource.data.answers.size() <= 200 &&
              request.resource.data.score is int && request.resource.data.total is int &&
              request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total &&
              request.resource.data.attemptNumber is int && request.resource.data.attemptNumber > 0 &&
              (
                // 전체 응시: 요약 문서(quizResults)와 같은 일괄 쓰기로 저장합니다.
                (request.resource.data.get('mode', 'full') == 'full' &&
                 getAfter(/databases/$(database)/documents/classes/$(cid)/weeks/$(wid)/quizResults/$(uid)).data.score == request.resource.data.score)
                ||
                // 배치 10: 틀린 문제만 다시 풀기. 부분 점수는 전체 점수와 비교할 수 없어 요약 문서(점수·첫 응시)는 그대로 두고 기록만 남깁니다.
                (request.resource.data.get('mode', 'full') == 'wrongOnly' &&
                 exists(/databases/$(database)/documents/classes/$(cid)/weeks/$(wid)/quizResults/$(uid)) &&
                 request.resource.data.total >= 1 &&
                 request.resource.data.total <= get(/databases/$(database)/documents/classes/$(cid)/weeks/$(wid)/quizResults/$(uid)).data.total)
              );
            allow update, delete: if admin();
          }
        }
        match /attendance/{uid} {
          allow get, list: if admin() ||
            (signedIn() && request.auth.uid == uid && enrolled(cid));
          allow create, update, delete: if admin();
        }
      }
    }
    // 강사 알림 기기(2026-10-30 D14): 강사 화면의 '알림 설정'에서 등록한 기기의 알림 주소(FCM 토큰).
    // 강사만 읽고 씁니다. 알림은 Cloud Functions가 보내며, 함수는 관리자 권한이라 이 규칙과 상관없이 읽습니다.
    match /adminDevices/{deviceId} {
      allow read, delete: if admin();
      allow create, update: if admin() &&
        request.resource.data.keys().hasOnly(['uid','token','label','createdAt','updatedAt','lastSeenAt','testRequestedAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096 &&
        request.resource.data.get('label', '') is string && request.resource.data.get('label', '').size() <= 80;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
